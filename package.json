{
  "name": "campusvault",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "node scripts/preparePrisma.js && prisma generate",
    "build": "node scripts/preparePrisma.js && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio",
    "setup": "npm run db:generate && npm run db:push && npm run db:seed",
    "test": "ts-node tests/verifyCompleteCampusVaultAudit.ts && ts-node tests/verifyAiAssistantPrivacy.ts && ts-node tests/verifyCryptoSecurity.ts && ts-node tests/verifyAiChatAttachmentAndUpload.ts",
    "test:attachment": "ts-node tests/verifyAiChatAttachmentAndUpload.ts",
    "test:gemini": "ts-node tests/verifyGeminiIntegration.ts",
    "test:audit": "ts-node tests/verifyCompleteCampusVaultAudit.ts",
    "test:ai": "ts-node tests/verifyAiAssistantPrivacy.ts",
    "test:roles": "ts-node tests/verifyRolePermissionsAndSupabase.ts",
    "test:env": "ts-node tests/verifyEnvironmentAndSecrets.ts",
    "test:crypto": "ts-node tests/verifyCryptoSecurity.ts",
    "test:engine": "npm test --prefix security-engine",
    "test:all": "npm test && npm run test:engine"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.15.0",
    "@supabase/supabase-js": "^2.119.2",
    "argon2": "^0.45.2",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.400.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.38",
    "prisma": "^5.15.0",
    "tailwindcss": "^3.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
